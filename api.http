# ==============================================================
# Pet Adoption API - Test Suite (VS Code REST Client)
# สไตล์การทดสอบแบบเดียวกับ cybersec-69 / 69-s1-cybersec
# สมาชิกคนที่ 3: REST API & Testing Lead (CRUD Endpoints & Test Suite)
#
# ✨ ระบบดึง Token และ ID ต่อเนื่องอัตโนมัติ (ไม่ต้องก๊อปปี้ไปใส่ .env แล้ว!)
# วิธีใช้งาน: กดปุ่ม "Send Request" ไล่จากบนลงล่างตามลำดับได้เลย
# ==============================================================

@baseUrl = http://localhost:9091

## 1.Admin

### 1.1 Admin Login
// ล็อกอินด้วยบัญชีแอดมิน (ระบบจะบันทึก Token อัตโนมัติสำหรับเรียกใช้ในข้อถัดๆ ไป)
# @name adminLogin
POST {{baseUrl}}/admin/login
Content-Type: application/json

{
    "email": "{{$dotenv ADMIN_EMAIL}}",
    "password": "{{$dotenv ADMIN_PASSWORD}}"
}

###

# ดึง Token แอดมินอัตโนมัติจาก Response ด้านบน
@adminToken = {{adminLogin.response.body.token}}

### 1.2 Admin Profile
// ดึง Token จากข้อ 1.1 มาใส่ใน Authorization Bearer ให้อัตโนมัติ
GET {{baseUrl}}/admin/users/me
Authorization: Bearer {{adminToken}}

---

## 2.User (Adopter / Staff)

### 2.1 User Signup (สมัครสมาชิกผู้ขอรับเลี้ยง)
# @name userRegister
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
    "email": "{{$dotenv USER_EMAIL}}",
    "password": "{{$dotenv USER_PASSWORD}}",
    "firstName": "{{$dotenv USER_FIRSTNAME}}",
    "lastName": "{{$dotenv USER_LASTNAME}}",
    "phone": "{{$dotenv USER_PHONE}}",
    "role": "ADOPTER"
}

### 2.2 User Login (เข้าสู่ระบบ)
// เข้าสู่ระบบผู้ขอรับเลี้ยง (ระบบจะบันทึก Token อัตโนมัติสำหรับเรียกใช้ในข้อถัดๆ ไป)
# @name userLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
    "email": "{{$dotenv USER_EMAIL}}",
    "password": "{{$dotenv USER_PASSWORD}}"
}

###

# ดึง Token ผู้ใช้อัตโนมัติจาก Response ด้านบน
@userToken = {{userLogin.response.body.token}}

### 2.3 User Forgot Password (ขอรีเซ็ตรหัสผ่านผ่าน Supabase Auth)
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json

{
    "email": "{{$dotenv USER_EMAIL}}"
}

### 2.4 User Profile (ดูข้อมูลโปรไฟล์ส่วนตัว)
// ดึง Token ผู้ใช้จากข้อ 2.2 ให้อัตโนมัติ
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{userToken}}

### 2.5 Upload Pet Image (อัปโหลดรูปภาพสัตว์เลี้ยงเข้า Storage Bucket 'pet-images')
// อัปโหลดไฟล์รูปภาพแบบ Multipart/form-data
# @name uploadImage
POST {{baseUrl}}/api/upload
Authorization: Bearer {{adminToken}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="image"; filename="pet.png"
Content-Type: image/png

< ./top.png
------WebKitFormBoundary7MA4YWxkTrZu0gW--

---

## 3.Content (Pet Adoption Operations)

### 3.1 Shelters (ศูนย์พักพิงสัตว์)

#### 3.1.1 Get all Shelters (ดูรายชื่อศูนย์พักพิงสัตว์ทั้งหมด)
GET {{baseUrl}}/api/shelters

#### 3.1.2 Create Shelter (ลงทะเบียนศูนย์พักพิงสัตว์ใหม่ - Admin เท่านั้น)
// สร้างศูนย์พักพิงสัตว์ (ระบบจะจำ shelterId ให้อัตโนมัติ)
# @name createShelter
POST {{baseUrl}}/api/shelters
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "name": "Happy Paws Sanctuary Bangkok",
    "location": "Bang Sue, Bangkok, Thailand",
    "contact_phone": "+66-2-555-1234",
    "email": "contact@happypaws.org"
}

###

# ดึง Shelter ID อัตโนมัติจาก Response ด้านบน
@shelterId = {{createShelter.response.body.data.id}}

#### 3.1.3 Get Shelter by ID (ดึง shelterId อัตโนมัติ)
GET {{baseUrl}}/api/shelters/{{shelterId}}

#### 3.1.4 Update Shelter (แก้ไขข้อมูลศูนย์พักพิงสัตว์ - Admin เท่านั้น)
PUT {{baseUrl}}/api/shelters/{{shelterId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "name": "Happy Paws Foundation Bangkok",
    "location": "Bang Sue, Bangkok 10800, Thailand",
    "contact_phone": "+66-2-555-9999",
    "email": "info@happypaws.org"
}

---

### 3.2 Categories (หมวดหมู่ / ชนิดสัตว์)

#### 3.2.1 Get all Categories (ดูหมวดหมู่สัตว์ทั้งหมด)
GET {{baseUrl}}/api/categories

#### 3.2.2 Create Category (สร้างหมวดหมู่สัตว์ใหม่ - Admin เท่านั้น)
// สร้างหมวดหมู่ (ระบบจะจำ categoryId ให้อัตโนมัติ)
# @name createCategory
POST {{baseUrl}}/api/categories
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "name": "Hamster",
    "description": "Small and cute pocket pets",
    "icon_url": "https://images.unsplash.com/photo-1548767797-d8c844163c4c"
}

###

# ดึง Category ID อัตโนมัติจาก Response ด้านบน
@categoryId = {{createCategory.response.body.data.id}}

#### 3.2.3 Get Category by ID (ดึง categoryId อัตโนมัติ)
GET {{baseUrl}}/api/categories/{{categoryId}}

#### 3.2.4 Update Category (แก้ไขหมวดหมู่ - Admin เท่านั้น)
PUT {{baseUrl}}/api/categories/{{categoryId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "name": "Hamster & Small Rodents",
    "description": "Small pocket pets including dwarf hamsters and gerbils"
}

---

### 3.3 Pets (จัดการข้อมูลสัตว์เลี้ยง)

#### 3.3.1 Get all Pets (ดูรายการสัตว์ทั้งหมด พร้อม Filter)
GET {{baseUrl}}/api/pets?status=AVAILABLE

#### 3.3.2 Create Pet (ลงทะเบียนสัตว์หาบ้านใหม่ - Staff / Admin)
// ใช้ categoryId และ shelterId ที่สร้างไว้ด้านบนอัตโนมัติ!
# @name createPet
POST {{baseUrl}}/api/pets
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "name": "Charlie",
    "category_id": "{{categoryId}}",
    "shelter_id": "{{shelterId}}",
    "breed": "Corgi",
    "age_months": 10,
    "gender": "MALE",
    "size": "MEDIUM",
    "status": "AVAILABLE",
    "description": "Cheerful and energetic dog with short legs and a huge heart.",
    "medical_history": "Vaccinated, dewormed, healthy.",
    "vaccinated": true,
    "spayed_neutered": true,
    "image_url": "https://images.unsplash.com/photo-1583511655857-d19b40a7a54e"
}

###

# ดึง Pet ID อัตโนมัติจาก Response ด้านบน
@petId = {{createPet.response.body.data.id}}

#### 3.3.3 Get Pet by ID (ดึง petId อัตโนมัติ)
GET {{baseUrl}}/api/pets/{{petId}}

#### 3.3.4 Update Pet (แก้ไขข้อมูลสัตว์เลี้ยง - Staff / Admin)
PUT {{baseUrl}}/api/pets/{{petId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "description": "Cheerful and energetic dog with short legs. Updated medical check complete.",
    "status": "AVAILABLE"
}

#### 3.3.5 Ask Question / Inquiry about Pet (ผู้สนใจสอบถามข้อมูลเพิ่มเติม)
// ใช้ petId และ userToken อัตโนมัติ
POST {{baseUrl}}/api/pets/{{petId}}/inquiries
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
    "message": "น้องเข้ากับแมวหรือเด็กเล็กได้ดีไหมครับ?"
}

---

### 3.4 Adoption Applications (ระบบคำขอรับเลี้ยงสัตว์)

#### 3.4.1 Submit Application (ผู้ใช้ยื่นใบคำขอรับเลี้ยงสัตว์)
// ใช้ petId และ userToken อัตโนมัติ
# @name createApplication
POST {{baseUrl}}/api/applications
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
    "pet_id": "{{petId}}",
    "living_condition": "Single house with a high-fenced green backyard",
    "has_other_pets": false,
    "reason_for_adoption": "I have experience taking care of dogs for 5 years and work from home permanently."
}

###

# ดึง Application ID อัตโนมัติจาก Response ด้านบน
@applicationId = {{createApplication.response.body.data.id}}

#### 3.4.2 Get Applications (ดูรายการใบสมัคร: ผู้ใช้เห็นเฉพาะของตนเอง / แอดมินเห็นทั้งหมด)
GET {{baseUrl}}/api/applications
Authorization: Bearer {{userToken}}

#### 3.4.3 Get Application by ID (ดึง applicationId อัตโนมัติ)
GET {{baseUrl}}/api/applications/{{applicationId}}
Authorization: Bearer {{userToken}}

#### 3.4.4 Update Application (แก้ไขข้อมูลคำขอรับเลี้ยง - Adopter)
PUT {{baseUrl}}/api/applications/{{applicationId}}
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
    "living_condition": "Single house with a high-fenced green backyard and shaded patio",
    "has_other_pets": false,
    "reason_for_adoption": "I have experience taking care of dogs for 6 years and work from home permanently."
}

#### 3.4.5 Review Application (เจ้าหน้าที่อนุมัติคำขอ - ระบบจะเปลี่ยนสถานะสัตว์เป็น ADOPTED โดยอัตโนมัติ)
PATCH {{baseUrl}}/api/applications/{{applicationId}}/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "status": "APPROVED",
    "review_notes": "Home inspection passed, adopter is financially ready and loving."
}

#### 3.4.6 Delete Application (ยกเลิกหรือลบคำขอรับเลี้ยงสัตว์ - Adopter หรือ Admin)
DELETE {{baseUrl}}/api/applications/{{applicationId}}
Authorization: Bearer {{adminToken}}

---

## 4.Cleanup (ทดสอบการลบข้อมูลตามลำดับที่ปลอดภัย)

#### 4.1 Delete Pet (ลบสัตว์เลี้ยงหลังทดสอบระบบเสร็จสิ้น)
DELETE {{baseUrl}}/api/pets/{{petId}}
Authorization: Bearer {{adminToken}}

#### 4.2 Delete Category (ลบหมวดหมู่สัตว์)
DELETE {{baseUrl}}/api/categories/{{categoryId}}
Authorization: Bearer {{adminToken}}

#### 4.3 Delete Shelter (ลบศูนย์พักพิงสัตว์)
DELETE {{baseUrl}}/api/shelters/{{shelterId}}
Authorization: Bearer {{adminToken}}
